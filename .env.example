APP_ENV=development
APP_NAME=AI Growth Ops Platform API

POSTGRES_DB=growth_ops
POSTGRES_USER=growth_ops
POSTGRES_PASSWORD=growth_ops
POSTGRES_HOST_PORT=5433

DATABASE_URL=postgresql+psycopg://growth_ops:growth_ops@db:5432/growth_ops
REDIS_URL=redis://redis:6379/0

NEXT_PUBLIC_APP_NAME=AI Growth Ops Platform
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_PROVIDER=demo-header
API_INTERNAL_BASE_URL=http://api:8000

# Production auth placeholders. Local demos still use header-based auth.
AUTH_PROVIDER=demo-header
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ISSUER_BASE_URL=
AUTH0_SECRET=
AUTH0_SCOPE=openid profile email
APP_BASE_URL=http://localhost:3000

# Local notification workflow settings. No real messages are sent by default.
NOTIFICATION_PROVIDER=mock
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_RETRY_MAX_SECONDS=3600
NOTIFICATION_ALERT_DEAD_LETTER_THRESHOLD=1
NOTIFICATION_ALERT_FAILED_JOB_THRESHOLD=1
NOTIFICATION_ALERT_STALLED_MINUTES=15
